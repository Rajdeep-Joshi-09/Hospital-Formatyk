generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model UserTypeMaster {
  id           Int       @id @default(autoincrement())
  userType     String    @db.VarChar
  isStatus     Int       @default(1)
  isDelete     Int       @default(0)
  createdBy    Int
  createdDate  DateTime  @default(now())
  modifiedBy   Int?
  modifiedDate DateTime? @updatedAt
  deletedBy    Int?
  deletedDate  DateTime?

  users       User[]
  permissions RolePermission[]
}

model User {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  phone    String
  password String

  userType     Int
  userTypeRole UserTypeMaster @relation(fields: [userType], references: [id])

  isStatus    Int       @default(1)
  isDelete    Int       @default(0)
  createdBy   Int
  createdAt   DateTime  @default(now())
  updatedBy   Int
  updatedDate DateTime  @updatedAt
  deletedBy   Int
  deletedDate DateTime?
}

model Menu {
  id            Int     @id @default(autoincrement())
  menuName      String
  pageName      String?
  formPageRoute String?
  listPageRoute String?
  sortOrder     Int     @default(0)
  icon          String?

  parentId Int?
  parent   Menu?  @relation("MenuHierarchy", fields: [parentId], references: [id])
  submenus Menu[] @relation("MenuHierarchy")

  isStatus    Int       @default(1)
  isDelete    Int       @default(0)
  createdBy   Int
  createdAt   DateTime  @default(now())
  updatedBy   Int
  updatedDate DateTime  @updatedAt
  deletedBy   Int       @default(0)
  deletedDate DateTime?

  permissions RolePermission[]
}

model RolePermission {
  id         Int @id @default(autoincrement())
  userTypeId Int
  menuId     Int
  isRead     Int @default(0)
  isWrite    Int @default(0)
  isEdit     Int @default(0)
  isDelete   Int @default(0)

  userType UserTypeMaster @relation(fields: [userTypeId], references: [id])
  menu     Menu           @relation(fields: [menuId], references: [id])

  createdBy   Int
  createdAt   DateTime  @default(now())
  updatedBy   Int?
  updatedDate DateTime? @updatedAt

  @@unique([userTypeId, menuId])
}

model ExpertiesMaster {
  id           Int       @id @default(autoincrement())
  expertyType  String    @db.VarChar
  isStatus     Int       @default(1)
  isDelete     Int       @default(0)
  createdBy    Int
  createdDate  DateTime  @default(now())
  modifiedBy   Int?
  modifiedDate DateTime? @updatedAt
  deletedBy    Int?
  deletedDate  DateTime?
  doctors      Doctor[]
}

model LanguageMaster {
  id           Int       @id @default(autoincrement())
  lang         String    @db.VarChar
  isStatus     Int       @default(1)
  isDelete     Int       @default(0)
  createdBy    Int
  createdDate  DateTime  @default(now())
  modifiedBy   Int?
  modifiedDate DateTime? @updatedAt
  deletedBy    Int?
  deletedDate  DateTime?
  doctors      Doctor[]
}

model Doctor {
  id           Int       @id @default(autoincrement())
  name         String    @db.VarChar
  image        String?   @db.VarChar
  experties    Int
  description  String?   @db.VarChar
  yearOfExp    Int?
  education    String?   @db.VarChar
  languages    Int
  isStatus     Int       @default(1)
  isDelete     Int       @default(0)
  createdBy    Int
  createdDate  DateTime  @default(now())
  modifiedBy   Int?
  modifiedDate DateTime? @updatedAt
  deletedBy    Int?
  deletedDate  DateTime?

  expertiesMaster ExpertiesMaster @relation(fields: [experties], references: [id])
  languageMaster  LanguageMaster  @relation(fields: [languages], references: [id])
  appointments    Appointment[]
  reviews         Review[]
}

model TreatmentTypeMaster {
  id           Int            @id @default(autoincrement())
  treatType    String         @db.VarChar
  isStatus     Int            @default(1)
  isDelete     Int            @default(0)
  createdBy    Int
  createdDate  DateTime       @default(now())
  modifiedBy   Int?
  modifiedDate DateTime?      @updatedAt
  deletedBy    Int?
  deletedDate  DateTime?
  specialities Specialities[]
}

model Specialities {
  id           Int       @id @default(autoincrement())
  speciality   String    @db.VarChar
  description  String?   @db.VarChar
  experience   Int?
  icon         String?   @db.VarChar
  treatType    Int
  isStatus     Int       @default(1)
  isDelete     Int       @default(0)
  createdBy    Int
  createdDate  DateTime  @default(now())
  modifiedBy   Int?
  modifiedDate DateTime? @updatedAt
  deletedBy    Int?
  deletedDate  DateTime?

  treatmentType TreatmentTypeMaster @relation(fields: [treatType], references: [id])
}

model SubjectMaster {
  id           Int       @id @default(autoincrement())
  subjects     String    @db.VarChar
  isStatus     Int       @default(1)
  isDelete     Int       @default(0)
  createdBy    Int
  createdDate  DateTime  @default(now())
  modifiedBy   Int?
  modifiedDate DateTime? @updatedAt
  deletedBy    Int?
  deletedDate  DateTime?
  inquiries    Inquiry[]
}

model Patient {
  id           Int       @id @default(autoincrement())
  name         String    @db.VarChar
  phone        String    @db.VarChar
  isStatus     Int       @default(1)
  isDelete     Int       @default(0)
  createdBy    Int       @default(0)
  createdDate  DateTime  @default(now())
  fcmToken     String?   @db.VarChar
  modifiedBy   Int?
  modifiedDate DateTime? @updatedAt
  deletedBy    Int?
  deletedDate  DateTime?

  appointments  Appointment[]
  reviews       Review[]
  notifications Notification[]
}

model Inquiry {
  id           Int       @id @default(autoincrement())
  name         String    @db.VarChar
  email        String    @db.VarChar
  phoneNumber  String    @db.VarChar
  subjectId    Int
  message      String    @db.VarChar
  isStatus     Int       @default(1)
  isDelete     Int       @default(0)
  createdBy    Int       @default(0)
  createdDate  DateTime  @default(now())

  subject      SubjectMaster @relation(fields: [subjectId], references: [id])
}

model Appointment {
  id              Int       @id @default(autoincrement())
  patientId       Int
  doctorId        Int
  appointmentDate DateTime
  appointmentTime String    @db.VarChar
  reason          String?   @db.VarChar
  status          String    @default("Pending") @db.VarChar
  createdBy       Int       @default(0)
  createdDate     DateTime  @default(now())
  modifiedBy      Int?
  modifiedDate    DateTime? @updatedAt

  patient Patient @relation(fields: [patientId], references: [id])
  doctor  Doctor  @relation(fields: [doctorId], references: [id])
}

model Review {
  id                Int       @id @default(autoincrement())
  patientId         Int
  doctorId          Int
  reviewDescription String    @db.VarChar
  ratings           Int
  isStatus          Int       @default(1)
  isDelete          Int       @default(0)
  createdBy         Int       @default(0)
  createdDate       DateTime  @default(now())

  patient Patient @relation(fields: [patientId], references: [id])
  doctor  Doctor  @relation(fields: [doctorId], references: [id])
}

model Notification {
  id           Int       @id @default(autoincrement())
  title        String    @db.VarChar
  description  String    @db.VarChar
  patientId    Int
  isStatus     Int       @default(1)
  isDelete     Int       @default(0)
  createdBy    Int       @default(0)
  createdDate  DateTime  @default(now())
  modifiedBy   Int?
  modifiedDate DateTime? @updatedAt
  deletedBy    Int?
  deletedDate  DateTime?

  patient Patient @relation(fields: [patientId], references: [id])
}
