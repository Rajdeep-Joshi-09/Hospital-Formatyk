generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model UserTypeMaster {
  id           Int       @id @default(autoincrement())
  userType     String    @db.VarChar
  isStatus     Int       @default(1)
  isDelete     Int       @default(0)
  createdBy    Int
  createdDate  DateTime  @default(now())
  modifiedBy   Int?
  modifiedDate DateTime? @updatedAt
  deletedBy    Int?
  deletedDate  DateTime?
  users        User[]
  permissions  RolePermission[]
}

model User {
  id          Int       @id @default(autoincrement())
  name        String
  email       String    @unique
  phone       String
  password    String
  
  userType    Int
  userTypeRole UserTypeMaster @relation(fields: [userType], references: [id])
  
  isStatus    Int       @default(1)
  isDelete    Int       @default(0)
  createdBy   Int
  createdAt   DateTime  @default(now())
  updatedBy   Int
  updatedDate DateTime  @updatedAt
  deletedBy   Int
  deletedDate DateTime?
}

model Menu {
  id            Int       @id @default(autoincrement())
  menuName      String
  pageName      String?
  formPageRoute String?
  listPageRoute String?
  sortOrder     Int       @default(0)
  icon          String?
  
  parentId      Int?
  parent        Menu?     @relation("MenuHierarchy", fields: [parentId], references: [id])
  submenus      Menu[]    @relation("MenuHierarchy")

  isStatus      Int       @default(1)
  isDelete      Int       @default(0)
  createdBy     Int
  createdAt     DateTime  @default(now())
  updatedBy     Int
  updatedDate   DateTime  @updatedAt
  deletedBy     Int       @default(0)
  deletedDate   DateTime?
  permissions   RolePermission[]
}

model RolePermission {
  id           Int       @id @default(autoincrement())
  userTypeId   Int
  menuId       Int
  isRead       Int       @default(0)
  isWrite      Int       @default(0)
  isEdit       Int       @default(0)
  isDelete     Int       @default(0)

  userType     UserTypeMaster @relation(fields: [userTypeId], references: [id])
  menu         Menu           @relation(fields: [menuId], references: [id])

  createdBy    Int
  createdAt    DateTime  @default(now())
  updatedBy    Int?
  updatedDate  DateTime? @updatedAt
  
  @@unique([userTypeId, menuId])
}

model ExpertiesMaster {
  id           Int       @id @default(autoincrement())
  expertyType  String    @db.VarChar
  isStatus     Int       @default(1)
  isDelete     Int       @default(0)
  createdBy    Int
  createdDate  DateTime  @default(now())
  modifiedBy   Int?
  modifiedDate DateTime? @updatedAt
  deletedBy    Int?
  deletedDate  DateTime?
}

model LanguageMaster {
  id           Int       @id @default(autoincrement())
  lang         String    @db.VarChar
  isStatus     Int       @default(1)
  isDelete     Int       @default(0)
  createdBy    Int
  createdDate  DateTime  @default(now())
  modifiedBy   Int?
  modifiedDate DateTime? @updatedAt
  deletedBy    Int?
  deletedDate  DateTime?
}
